{
    "manifest_version": 3,
    "name": "Sensory Shield",
    "version": "0.1.0",
    "description": "Neutralize distracting web content for neurodiverse users.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_title": "Sensory Shield",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}